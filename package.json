{
  "name": "ex-osero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "vite --host --open",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "sim:smoke": "tsx src/sim/cli.ts smoke",
    "sim:benchmark": "tsx src/sim/cli.ts benchmark",
    "rl:check": ".venv\\Scripts\\python.exe training\\run.py check",
    "rl:train:smoke": ".venv\\Scripts\\python.exe training\\run.py train --timesteps 32768 --seed 42",
    "rl:evaluate": ".venv\\Scripts\\python.exe training\\run.py evaluate",
    "rl:diagnose": ".venv\\Scripts\\python.exe training\\run.py diagnose --out-run-id phase6-diagnostics-001",
    "rl:speed": ".venv\\Scripts\\python.exe training\\run.py speed --out-run-id phase6-speed-001",
    "rl:train:phase6": ".venv\\Scripts\\python.exe training\\run.py train --run-id phase6-retrain-001 --timesteps 16384 --seed 42 --compress-forced-wait --checkpoint-every 8192 --init-from training/artifacts/phase5-smoke-001/initial_model.zip",
    "rl:evaluate:phase6": ".venv\\Scripts\\python.exe training\\run.py evaluate-phase6 --run-id phase6-retrain-001",
    "strategy:verify": "tsx src/cpu/strategy/bench.ts verify",
    "strategy:speed": "tsx src/cpu/strategy/bench.ts speed",
    "strategy:profile": "tsx src/cpu/strategy/bench.ts profile",
    "strategy:match": "tsx src/cpu/strategy/bench.ts match 20",
    "strategy:human": "tsx src/cpu/strategy/bench.ts human 10 max_flip",
    "strategy:ladder": "tsx src/cpu/strategy/bench.ts ladder 20",
    "strategy:agree": "tsx src/cpu/strategy/bench.ts agree 12",
    "ga:smoke": "tsx src/ga/cli.ts smoke --run-id ga1-smoke-001 --seed 20260913",
    "ga:train": "tsx src/ga/cli.ts train --run-id ga1-train-001 --seed 20260913",
    "ga:resume": "tsx src/ga/cli.ts resume --run-id ga1-train-001",
    "ga:evaluate": "tsx src/ga/cli.ts evaluate",
    "ga:continue": "tsx src/ga/cli.ts continue --run-id ga1-train-002 --from-run ga1-train-001 --seed 20260914 --start-generation 21 --generations 31",
    "ga:continue:resume": "tsx src/ga/cli.ts resume --run-id ga1-train-002",
    "ga:retrain": "tsx src/ga/cli.ts continue --run-id ga1-train-003 --from-milestones --seed 20260914 --start-generation 1 --generations 16",
    "ga:retrain:resume": "tsx src/ga/cli.ts resume --run-id ga1-train-003",
    "ga:pick-milestone": "tsx src/ga/cli.ts pick-milestone",
    "ga:tournament": "tsx src/ga/cli.ts tournament",
    "ga:longrun": "tsx src/ga/cli.ts continue --from-best --run-id ga1-train-004 --seed 20260915 --start-generation 1 --generations 21",
    "ga:longrun:resume": "tsx src/ga/cli.ts resume --run-id ga1-train-004",
    "ga:status": "tsx src/ga/cli.ts status --run-id ga1-train-004 --notify",
    "ga:status:watch": "tsx src/ga/cli.ts status --run-id ga1-train-004 --notify --watch --interval 20",
    "ai": "tsx src/ai/cli.ts",
    "ai:agents": "tsx src/ai/cli.ts agents",
    "ai:bench": "tsx src/ai/cli.ts bench",
    "ai:status": "tsx src/ai/cli.ts status",
    "ai:pipeline": "tsx src/ai/cli.ts pipeline",
    "ai:pipeline:smoke": "tsx src/ai/cli.ts pipeline --iterations 1 --games 40 --selfplay-sims 48 --eval-sims 64 --eval-games 40",
    "ai:ladder": "tsx src/ai/cli.ts ladder"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
